SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=cloche-assets

# Base URLs used in email verification links + redirects
# BACKEND_BASE_URL should point to where this API is hosted (Render/Vercel/etc)
BACKEND_BASE_URL=https://cloche-backend.onrender.com
# FRONTEND_BASE_URL should point to where the public HTML pages are served
FRONTEND_BASE_URL=https://cloche-backend.onrender.com

# Cloudinary upload is used automatically when these are set.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Optional, but recommended if you want product-image deletes to remove the asset from Cloudinary too.
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=cloche

# Gmail API (OAuth2) used for verification emails
GMAIL_USER=cloche.luxury@gmail.com
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_google_oauth_refresh_token
